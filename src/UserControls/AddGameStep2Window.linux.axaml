<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DLSS_Swapper.Avalonia.Views.AddGameStep2Window"
        Title="Another note for manually adding games" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#242424">

    <Border Padding="24" Background="#242424" CornerRadius="8">
        <StackPanel Spacing="18">
            <!-- Title -->
            <TextBlock x:Name="TitleTextBlock" Text="Another note for manually adding games" FontSize="18" FontWeight="SemiBold" Foreground="White"/>

            <!-- Message Body formatted with localized rich inlines -->
            <TextBlock x:Name="MessageBodyTextBlock" FontSize="13" Foreground="#DDDDDD" TextWrapping="Wrap" LineHeight="22"/>

            <!-- Action Buttons Footer -->
            <Border Padding="0,15,0,0" BorderBrush="#333333" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,*">
                    <Button x:Name="AddGameButton" Grid.Column="0" Content="Add Game" Click="OnAddGameClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Background="{DynamicResource AppAccentBrush}" Foreground="Black" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,8,0"/>
                    <Button x:Name="CloseButton" Grid.Column="1" Content="Close" Click="OnCloseClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Background="#333333" Foreground="White" CornerRadius="4" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
