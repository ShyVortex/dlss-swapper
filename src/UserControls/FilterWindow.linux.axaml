<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DLSS_Swapper.Avalonia.Views.FilterWindow"
        Title="Filter" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#242424">

    <Border Padding="24" Background="#242424" CornerRadius="8">
        <StackPanel Spacing="18">
            <!-- Title -->
            <TextBlock Text="Filter" FontSize="18" FontWeight="SemiBold" Foreground="White"/>

            <!-- Options Group -->
            <StackPanel Spacing="10">
                <TextBlock Text="Options:" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                <CheckBox x:Name="HideNoSwappableCheckBox" Content="Hide games with no swappable items" IsChecked="False" Foreground="#DDDDDD" FontSize="13"/>
                <CheckBox x:Name="ShowHiddenCheckBox" Content="Show hidden games (defaults to off on launch)" IsChecked="False" Foreground="#DDDDDD" FontSize="13"/>
            </StackPanel>

            <!-- Grouping Group -->
            <StackPanel Spacing="10">
                <TextBlock Text="Grouping:" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                <CheckBox x:Name="GroupLibraryCheckBox" Content="Group games from the same library together" IsChecked="True" Foreground="#DDDDDD" FontSize="13"/>
            </StackPanel>

            <!-- Action Buttons Footer -->
            <Border Padding="0,15,0,0" BorderBrush="#333333" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,*">
                    <Button Grid.Column="0" Content="Apply" Click="OnApplyClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Background="#E8A068" Foreground="Black" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Cancel" Click="OnCancelClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="36" Background="#333333" Foreground="White" CornerRadius="4" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
