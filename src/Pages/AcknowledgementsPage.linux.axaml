<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DLSS_Swapper.Pages"
        x:Class="DLSS_Swapper.Pages.AcknowledgementsPage"
        Title="Licences &amp; Acknowledgements"
        Width="960" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#1E1E1E">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Bar Header -->
        <Border Grid.Row="0" Background="#252526" Padding="20,14" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <TextBlock x:Name="TitleTextBlock" Text="Licences &amp; Acknowledgements" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="260, *">
            <!-- Left Sidebar Navigation List -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,1,0">
                <ListBox x:Name="ItemsListBox" Background="Transparent" SelectionChanged="OnSelectionChanged" Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="views:AcknowledgementItem">
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="White" Padding="8,6"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right Detail Content Panel -->
            <ScrollViewer Grid.Column="1" Padding="24,24,36,24">
                <StackPanel Spacing="16" Margin="0,0,12,0">
                    <!-- Notes / Description -->
                    <TextBlock x:Name="NotesTextBlock" TextWrapping="Wrap" FontSize="13" Foreground="#DDDDDD" IsVisible="False"/>

                    <Border x:Name="NotesSeparator" Height="1" Background="#333333" Margin="0,4" IsVisible="False"/>

                    <!-- Licence Text -->
                    <TextBox x:Name="LicenseTextBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="12"
                             FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                             Background="#141414" Foreground="#CCCCCC" BorderBrush="#333333" BorderThickness="1"
                             CornerRadius="4" Padding="12" MinHeight="300" IsVisible="False"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
