<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DLSS_Swapper.DiagnosticsWindow"
        Title="Diagnostics"
        Width="880" Height="580"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#181818">

    <Grid x:Name="RootGrid" RowDefinitions="Auto, *" PointerPressed="OnRootGridPointerPressed" Focusable="True" Background="Transparent">
        <!-- Top Action Bar -->
        <Border Grid.Row="0" Background="#242424" Padding="16,12" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Button x:Name="CopyDetailsButton" Content="Click to copy below details" Click="OnCopyDetailsClick"
                    Padding="14,8" Background="#2C2C2C" Foreground="White" BorderThickness="0" CornerRadius="4" Cursor="Hand"/>
        </Border>

        <!-- Main Diagnostics Log View -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <TextBox x:Name="DiagnosticsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontSize="12"
                     Background="#121212" Foreground="#D4D4D4" BorderBrush="#333333" BorderThickness="1"
                     CornerRadius="4" Padding="16" MinHeight="460">
                <TextBox.Styles>
                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                        <Setter Property="BorderBrush" Value="#444444" />
                    </Style>
                </TextBox.Styles>
            </TextBox>
        </ScrollViewer>
    </Grid>
</Window>
