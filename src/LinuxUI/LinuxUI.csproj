<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>DLSS_Swapper.LinuxUI</RootNamespace>
    <AssemblyName>DLSS Swapper</AssemblyName>
    <Version>1.2.6.0</Version>
    <AssemblyVersion>1.2.6.0</AssemblyVersion>
    <FileVersion>1.2.6.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinuxCore\LinuxCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\Assets\icon_256.png" Link="Assets\icon_256.png" />
    <AvaloniaXaml Include="..\**\*.linux.axaml" Exclude="..\LinuxCore\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\**\*.linux.axaml.cs" Exclude="..\LinuxCore\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\**\*.linux.cs" Exclude="..\LinuxCore\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
