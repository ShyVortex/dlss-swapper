<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DLSS_Swapper"
        x:Class="DLSS_Swapper.TranslationToolboxWindow"
        Title="Translation Toolbox"
        Width="1100" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#181818">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Toolbar Header -->
        <Border Grid.Row="0" Background="#242424" Padding="16,12" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Left: Source language and progress info -->
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="SourceLanguageLabel" Text="Source language:" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SourceLanguageComboBox" Width="240" SelectionChanged="OnSourceLanguageChanged"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="TranslationProgressLabel" Text="Translation progress:" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TranslationProgressValue" Text="0 / 0 (0%)" Foreground="{DynamicResource AppAccentBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="HelpButton" Content="Help" Click="OnHelpClick"
                            Padding="12,6" Background="#2C2C2C" Foreground="White" BorderThickness="0" CornerRadius="4" Cursor="Hand"/>
                    <Button x:Name="LoadExistingButton" Content="Load Existing" Click="OnLoadExistingClick"
                            Padding="12,6" Background="#2C2C2C" Foreground="White" BorderThickness="0" CornerRadius="4" Cursor="Hand"/>
                    <Button x:Name="LoadButton" Content="Load" Click="OnLoadClick"
                            Padding="12,6" Background="#2C2C2C" Foreground="White" BorderThickness="0" CornerRadius="4" Cursor="Hand"/>
                    <Button x:Name="SaveButton" Content="Save" Click="OnSaveClick"
                            Padding="12,6" Background="#2C2C2C" Foreground="White" BorderThickness="0" CornerRadius="4" Cursor="Hand"/>
                    <Button x:Name="PublishButton" Content="Publish" Click="OnPublishClick"
                            Padding="12,6" Background="{DynamicResource AppAccentBrush}" Foreground="Black" FontWeight="SemiBold" BorderThickness="0" CornerRadius="4" Cursor="Hand"/>
                    <Border Width="1" Height="20" Background="#444444" Margin="4,0"/>
                    <Button x:Name="ReloadAppButton" Content="Reload app" Click="OnReloadAppClick"
                            Padding="12,6" Background="#2C2C2C" Foreground="White" BorderThickness="0" CornerRadius="4" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Translation DataGrid -->
        <DataGrid Grid.Row="1" x:Name="TranslationDataGrid" x:DataType="local:TranslationRow" AutoGenerateColumns="False" SelectionMode="Single"
                  GridLinesVisibility="All" Background="#141414" Foreground="White" Margin="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Width="220" Binding="{Binding Key}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Comment" Width="240" Binding="{Binding Comment}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Source translation" Width="300" Binding="{Binding SourceTranslation}" IsReadOnly="True"/>
                <DataGridTextColumn Header="New translation" Width="*" Binding="{Binding NewTranslation, Mode=TwoWay}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
